# ═══════════════════════════════════════════════════════════════════
# KuramaChain — Configurações de Ambiente
# ═══════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ─── Rede / API ──────────────────────────────────────────────────
PORT=5000
DIFFICULTY=4
HOST=0.0.0.0

# ─── Segurança ───────────────────────────────────────────────────
# Secret compartilhado entre nós para autenticação P2P (HMAC-SHA256).
# Obrigatório para P2P: sem ele as rotas de rede ficam fechadas (fail-closed).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
NETWORK_SECRET=

# Aceitar X-Forwarded-For no rate limit. Ative SÓ quando o nó estiver atrás
# de um proxy reverso controlado — caso contrário o header é forjável e
# anula o limite por IP.
# TRUST_PROXY_HEADERS=true

# Caminho para certificados SSL (gerados automaticamente se não existirem)
# SSL_CERT_DIR=certs
# SSL_CERT_FILE=certs/cert.pem
# SSL_KEY_FILE=certs/key.pem
# CA_CERT_FILE=certs/ca.pem

# Forçar HTTPS (true) ou usar HTTP (false)
# USE_HTTPS=true

# ─── Blockchain ──────────────────────────────────────────────────
# Supply máximo: 1 bilhão de KUR
# TOTAL_SUPPLY_CAP=1000000000
# Recompensa inicial por bloco (10 KUR)
# INITIAL_BLOCK_REWARD=10
# Intervalo de halving (blocos)
# HALVING_INTERVAL=200000

# ─── Modo Produção ──────────────────────────────────────────────
# Se ativado, requer CA_CERT_FILE e pacote 'cryptography'
# KURAMA_PRODUCTION=false

# Expor a chave privada em /wallet/new e /wallet/restore.
# Padrão: false. Só ligue em dev local e nunca em deploy público.
# KURAMA_DEV_EXPOSE_KEYS=true

# ─── Rede P2P ───────────────────────────────────────────────────
# Teto de peers registrados e portas permitidas (aceita intervalos).
# P2P_MAX_PEERS=50
# P2P_ALLOWED_PORTS=80,443,5000-5010

# ─── Persistência ───────────────────────────────────────────────
# DATA_DIR=data
# CHAIN_FILE=data/blockchain.json
